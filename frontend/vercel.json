{
  "version": 2,
  "name": "saviour-face-recognition-mobile-pwa",
  "routes": [
    {
      "src": "^/sw.js$",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/sw.js"
    },
    {
      "src": "^/manifest.webmanifest$",
      "headers": {
        "content-type": "application/manifest+json; charset=utf-8"
      },
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
